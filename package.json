{
  "name": "perspective",
  "version": "0.1.0",
  "private": true,
  "description": "Moustique's powers of ten: one continuous zoom from a proton to the edge of the observable universe.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "design": "node scripts/extract-design.mjs",
    "dev": "npm run design && vite",
    "build": "npm run design && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "npm run design && tsc --noEmit",
    "test": "npm run design && vitest run",
    "test:e2e": "playwright test",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
